{
  "name": "pr-changelog-gen",
  "version": "1.1.3",
  "description": "Changelog generator based on GitHub Pull Requests",
  "bin": "./bin/pr-changelog-gen.mjs",
  "types": "./dist/types/node-binding.d.ts",
  "exports": {
    ".": {
      "default": "./dist/esm/node-binding.mjs",
      "types": "./dist/types/node-binding.d.ts"
    }
  },
  "scripts": {
    "build": "./scripts/build.mjs",
    "fix:lint": "oxlint --fix",
    "fmt": "dprint fmt",
    "test:lint": "oxlint",
    "test:fmt": "dprint fmt --fail-on-change",
    "test:tsc": "tsc --noEmit",
    "test:unit": "vitest run",
    "upgrade:deps": "node ./scripts/upgrade-deps.mjs",
    "prepare": "husky install"
  },
  "license": "MIT",
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "clify": "ncpa0cpl/clify.js#0.0.4",
    "date-fns": "^4.4.0",
    "dilswer": "^3.2.1",
    "git-url-parse": "^16.1.0",
    "parse-github-repo-url": "^1.4.1",
    "reflect-metadata": "^0.2.2",
    "semver": "^7.8.5",
    "termx-markup": "^2.1.6"
  },
  "devDependencies": {
    "@ncpa0cpl/nodepack": "^2.1.3",
    "@types/git-url-parse": "^16.0.2",
    "@types/node": "^26.1.2",
    "@types/parse-github-repo-url": "^1.4.2",
    "@types/semver": "^7.7.1",
    "axios": "^1.18.1",
    "dprint": "^0.55.2",
    "esbuild": "^0.28.1",
    "git-hook-tasks": "git+https://github.com/ncpa0cpl/git-hook-tasks#2.0.1",
    "husky": "^8.0.3",
    "oxlint": "^1.76.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ncpa0/pr-changelog-gen.git"
  },
  "keywords": [
    "pr-log",
    "changelog",
    "changelog.md",
    "github",
    "history",
    "history.md"
  ],
  "maintainers": [
    "Szymon Bretner <szymonb21@gmail.com"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "packageManager": "yarn@3.5.0"
}
